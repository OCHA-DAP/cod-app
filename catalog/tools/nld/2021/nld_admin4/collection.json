  "table:columns": [
    {
      "name": "geometry",
      "type": "binary",
      "description": "Polygon or MultiPolygon in OGC:CRS84, reprojected from EPSG:28992 (RD New). Gemeente boundaries come from Kadaster BRK and the land/water split from CBS Bestand Bodemgebruik. Not generalized."
    },
    {
      "name": "buurtcode",
      "type": "string",
      "description": "Buurt (neighbourhood) code: `BU` plus 8 digits (4 gemeente, 2 wijk, 2 buurt). Water-only buurten end in `9997` (inland lakes) or `9998` (sea and estuaries)."
    },
    {
      "name": "buurtnaam",
      "type": "string",
      "description": "Buurt name, as set by the gemeente."
    },
    {
      "name": "wijkcode",
      "type": "string",
      "description": "Wijk (district) code: `WK` plus 6 digits (4 gemeente, 2 wijk)."
    },
    {
      "name": "gemeentecode",
      "type": "string",
      "description": "Gemeente (municipality) code: `GM` plus 4 digits, set by CBS with the Ministry of the Interior (BZK). A rename changes the code."
    },
    {
      "name": "gemeentenaam",
      "type": "string",
      "description": "Official gemeente name."
    },
    {
      "name": "water",
      "type": "string",
      "description": "`JA` water, `NEE` land, `B` Belgian territory around Baarle-Nassau (gemeente `GM0998` Buitenland)."
    },
    {
      "name": "jaar",
      "type": "int32",
      "description": "Vintage year of the Wijk- en Buurtkaart."
    }
  ],
