{
  "name": "cod-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-py-docs.mjs",
    "predev": "npm run sync:assets",
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "prebuild": "npm run sync:assets",
    "build": "astro build",
    "preview": "astro preview",
    "fetch:status": "uv run -m cod_data.status.m49 && uv run -m cod_data.status.gis && uv run -m cod_data.status.plans && uv run -m cod_data.status.regions && uv run -m cod_data.status.offices && uv run -m cod_data.status.cod_metadata && uv run -m cod_data.status.hdx && (uv run -m cod_data.status.cod_ps || echo '::warning::cod_ps.py failed, COD-PS columns will be empty') && uv run -m cod_data.status.jira && date -u +%Y-%m-%dT%H:%M:%SZ > public/status/data/last_updated.txt",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update": "npx npm-check-updates -u && npm install",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/svelte": "^9.1.6",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@vitest/browser-playwright": "^5.1.1",
    "astro": "^7.4.13",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sirv": "^3.0.2",
    "svelte": "^5.58.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "^0.43.1",
    "@duckdb/duckdb-wasm": "1.33.1-dev119.0",
    "astro-rehype-relative-markdown-links": "^0.19.2",
    "fflate": "^0.8.3",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "maplibre-gl": "^6.19.0",
    "papaparse": "^5.7.1",
    "pmtiles": "^4.5.0"
  }
}
