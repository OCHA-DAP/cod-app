---
import { explorerViews } from "$lib/talk/explorer";
import { steps } from "$lib/steps";
import { tools } from "$lib/tools";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "$lib/components/SiteHeader.astro";
import * as intro from "$lib/talk/intro.md";
import * as outro from "$lib/talk/outro.md";

import { base, toolsBase } from "$lib/utils/paths";

// Root-relative links resolve against the deploy base; links open in a new tab so the talk never navigates away.
const toSlides = async (md: typeof intro) =>
  (await md.compiledContent())
    .replace(/(href|src)="\/(?!\/)/g, `$1="${base}`)
    .replace(/<a href=/g, '<a target="_blank" rel="noopener" href=')
    .split(/<hr\s*\/?>/)
    .map((html) => html.trim())
    .filter(Boolean);

const demos = steps
  .map((s) => tools.find((t) => t.slug === s.slug))
  .filter((t) => t?.demo)
  .map((t) => ({ ...t!, href: `${toolsBase}${t!.slug}?${new URLSearchParams(t!.demo)}` }));

// A slide holding one of these comments gets the cycling boundary map, the six-step diagram or the DuckDB diagram in its place.
const EXPLORER_MARKER = "<!-- explorer -->";
const STEPS_MARKER = "<!-- steps -->";
const GLUE_MARKER = "<!-- duckdb -->";
// A slide holding this comment keeps its image full width with the bullets underneath.
const WIDE_MARKER = "<!-- wide -->";
// A slide that opens with an h1 (after any comments) gets the title-slide style.
const isTitle = (html: string) => /^(<!--[\s\S]*?-->\s*)*<h1/.test(html);

const before = await toSlides(intro);
const after = await toSlides(outro);
---

<Layout
  title="Slides | Tools"
  description="An introduction to COD-AB: why shared admin boundaries matter, the standard UN agencies agreed, and the browser tools that clean boundaries to it."
>
  <div class="talk">
    <SiteHeader class="site-bar">
      <button type="button" class="toggle" data-toggle>
        Present (P)
      </button>
    </SiteHeader>
    <main class="deck">
      {before.map((html, i) =>
        html.includes(EXPLORER_MARKER) ? (
          <section class="slide demo explorer">
            <Fragment set:html={html.split(EXPLORER_MARKER)[0]} />
            <figure>
              <div class="boundary-map" role="img" aria-label="Admin boundaries by source"></div>
              <figcaption>{explorerViews[0].caption}</figcaption>
            </figure>
            <Fragment set:html={html.split(EXPLORER_MARKER)[1]} />
          </section>
        ) : html.includes(STEPS_MARKER) ? (
          <section class="slide">
            <Fragment set:html={html.split(STEPS_MARKER)[0]} />
            <ol class="pipeline">
              {steps.map((s) => (
                <li>
                  <span class="num">{s.n}</span>
                  <strong>{s.title}</strong>
                  <span class="brief">{s.brief}</span>
                </li>
              ))}
            </ol>
            <Fragment set:html={html.split(STEPS_MARKER)[1]} />
          </section>
        ) : html.includes(GLUE_MARKER) ? (
          <section class="slide">
            <Fragment set:html={html.split(GLUE_MARKER)[0]} />
            <div class="glue">
              <div>
                <strong>Python CLI</strong>
                <span>DuckDB</span>
              </div>
              <div class="core">
                <strong>Spatial SQL</strong>
                <span>DuckDB</span>
              </div>
              <div>
                <strong>Web app</strong>
                <span>DuckDB-WASM</span>
              </div>
            </div>
            <Fragment set:html={html.split(GLUE_MARKER)[1]} />
          </section>
        ) : (
          <section
            class:list={[
              "slide",
              {
                title: i === 0 || isTitle(html),
                "grid-bg": i === 0 || isTitle(html),
                wide: html.includes(WIDE_MARKER),
              },
            ]}
          >
            <Fragment set:html={html} />
            {i === 0 && (
              <div class="logos">
                <img src={`${base}logos/cod-logo.svg`} alt="Common Operational Datasets" />
              </div>
            )}
          </section>
        ),
      )}
      {demos.map((t) => (
        <section class="slide demo">
          <h2>{t.name}</h2>
          <iframe title={`${t.name} demo`} data-src={t.href} src="about:blank"></iframe>
          <p>{t.tagline}</p>
        </section>
      ))}
      {after.map((html) => (
        <section
          class:list={["slide", { title: isTitle(html), "grid-bg": isTitle(html) }]}
          set:html={html}
        />
      ))}
    </main>
  </div>
</Layout>

<script>
  import { loadBoundaries, startBoundaryLoop } from "$lib/talk/boundaryMap";
  loadBoundaries().catch(() => {});
  const slides = [...document.querySelectorAll<HTMLElement>(".slide")];
  const body = document.body;
  let current = 0;

  // Each demo runs its own DuckDB, so only on-screen demos stay loaded.
  const setLoaded = (slide: Element, on: boolean) => {
    const frame = slide.querySelector<HTMLIFrameElement>("iframe[data-src]");
    const src = on ? frame?.dataset.src : "about:blank";
    if (frame && src && frame.getAttribute("src") !== src) frame.src = src;
    if (slide === explorer) setCycling(on);
  };

  // Like a demo iframe, the boundary map only exists while its slide is on screen.
  const explorer = document.querySelector<HTMLElement>(".slide.explorer");
  let stopLoop: (() => void) | undefined;
  const setCycling = (on: boolean) => {
    if (on === (stopLoop !== undefined)) return;
    stopLoop?.();
    stopLoop = on
      ? startBoundaryLoop(
          explorer!.querySelector(".boundary-map")!,
          explorer!.querySelector("figcaption")!,
          1500,
        )
      : undefined;
  };

  const show = (i: number) => {
    current = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, j) => s.classList.toggle("current", j === current));
    if (body.classList.contains("present")) slides.forEach((s, j) => setLoaded(s, j === current));
    history.replaceState(null, "", `${location.search}#${current + 1}`);
    if (!body.classList.contains("present")) slides[current].scrollIntoView();
  };

  const setPresent = (on: boolean) => {
    body.classList.toggle("present", on);
    const url = new URL(location.href);
    if (on) url.searchParams.set("present", "");
    else url.searchParams.delete("present");
    history.replaceState(null, "", url);
    show(current);
  };

  // In read mode, track the slide nearest the top so P presents from where the reader is.
  const observer = new IntersectionObserver(
    (entries) => {
      if (body.classList.contains("present")) return;
      const hit = entries.find((e) => e.isIntersecting);
      if (hit) {
        current = slides.indexOf(hit.target as HTMLElement);
        history.replaceState(null, "", `${location.search}#${current + 1}`);
      }
    },
    { rootMargin: "0px 0px -70% 0px" },
  );
  slides.forEach((s) => observer.observe(s));

  const demoObserver = new IntersectionObserver(
    (entries) => {
      if (body.classList.contains("present")) return;
      entries.forEach((e) => setLoaded(e.target, e.isIntersecting));
    },
    { rootMargin: "200px 0px" },
  );
  document.querySelectorAll(".slide.demo").forEach((s) => demoObserver.observe(s));

  const onKey = (e: KeyboardEvent) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "p" || e.key === "P") return setPresent(!body.classList.contains("present"));
    if (!body.classList.contains("present")) return;
    if (e.key === "Escape") return setPresent(false);
    const step = {
      ArrowRight: 1,
      ArrowDown: 1,
      PageDown: 1,
      " ": 1,
      ArrowLeft: -1,
      ArrowUp: -1,
      PageUp: -1,
    }[e.key];
    if (step) show(current + step);
    else if (e.key === "Home") show(0);
    else if (e.key === "End") show(slides.length - 1);
    else return;
    e.preventDefault();
  };
  document.addEventListener("keydown", onKey);

  // Keys typed inside a demo stay with the tool, apart from clicker keys and Escape.
  document.querySelectorAll<HTMLIFrameElement>("iframe[data-src]").forEach((frame) =>
    frame.addEventListener("load", () =>
      frame.contentWindow?.addEventListener("keydown", (e) => {
        if (["PageUp", "PageDown", "Escape"].includes(e.key)) onKey(e);
      }),
    ),
  );

  document
    .querySelector("[data-toggle]")!
    .addEventListener("click", () => setPresent(!body.classList.contains("present")));

  current = Math.max(0, (parseInt(location.hash.slice(1), 10) || 1) - 1);
  if (new URLSearchParams(location.search).has("present")) setPresent(true);
  else if (location.hash) show(current);
</script>

<style>
  .talk {
    font-family: var(--brand-font);
    min-height: 100vh;
    background: var(--cd-grey--300);
  }
  .talk :global(.site-bar) {
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .toggle {
    margin-left: auto;
    font-size: 0.875rem;
    font: inherit;
    color: var(--cd-grey--800);
    background: #fff;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius);
    padding: 0.3rem 0.7rem;
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    .toggle {
      display: none;
    }
  }
  .toggle:hover {
    color: var(--cd-grey--900);
    border-color: var(--brand-primary--text);
  }
  .deck {
    max-width: 860px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .slide {
    scroll-margin-top: 4rem;
    padding: 2rem 2.25rem;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius--sm);
    background-color: #fff;
    line-height: 1.55;
  }
  .slide :global(h1),
  .slide :global(h2) {
    font-family: var(--brand-font-heading);
  }
  .slide :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
  .slide :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-primary--text);
    margin: 0 0 1.25rem;
  }
  .slide :global(h2)::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 0.5rem;
    background: var(--brand-primary);
  }
  .slide :global(h3) {
    font-size: 1.05rem;
    font-weight: 400;
    margin: 0 0 0.25rem;
  }
  .slide :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    font-size: 1.1rem;
  }
  .slide :global(li::marker) {
    color: var(--brand-primary--text);
  }
  .slide :global(li + li) {
    margin-top: 0.35rem;
  }
  .slide :global(table) {
    border-collapse: collapse;
    margin: 0 0 1rem;
    font-size: 1.05rem;
  }
  .slide :global(th) {
    color: var(--brand-primary--text);
    font-size: 0.8em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .slide :global(th),
  .slide :global(td) {
    text-align: left;
    padding: 0.4rem 1.5rem 0.4rem 0;
    border-bottom: 1px solid var(--cd-grey--500);
  }
  .slide :global(code) {
    font-size: 0.95em;
  }
  .slide :global(a) {
    color: var(--brand-primary--text);
  }
  .slide :global(img) {
    max-width: 100%;
  }
  .slide :global(p) {
    color: var(--cd-grey--800);
    margin: 0.75rem 0 0;
    max-width: 68ch;
  }
  .slide :global(h3 + p),
  .slide :global(ul + p),
  .slide :global(table + p) {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--cd-grey--500);
  }
  .title {
    border-color: var(--cd-blue--lightest);
  }
  .title :global(h1) {
    font-size: 2.6rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--brand-primary--text);
  }
  .title :global(h3) {
    color: var(--cd-grey--800);
  }
  .logos {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
  }
  .logos img {
    height: 3.5rem;
    width: auto;
  }
  .demo iframe {
    display: block;
    width: 100%;
    height: 640px;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius--sm);
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: auto auto 1fr;
    column-gap: 1.5rem;
    list-style: none;
    margin: 0.5rem 0 1rem;
    padding: 0;
  }
  .pipeline li {
    position: relative;
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0.4rem;
    min-height: 11rem;
    padding: 1.1rem 0.8rem 0.8rem;
    font-size: 0.8em;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius);
    box-shadow: inset 0 6px 0 var(--brand-primary--text);
    background: var(--cd-white);
  }
  .pipeline li + li {
    margin-top: 0;
  }
  .pipeline .num {
    display: grid;
    place-items: center;
    width: 2em;
    height: 2em;
    border-radius: 50%;
    background: var(--brand-primary--text);
    color: var(--cd-white);
    font-weight: 600;
  }
  .pipeline strong {
    color: var(--brand-primary--text);
  }
  .pipeline strong {
    line-height: 1.2;
  }
  .pipeline .brief {
    font-size: 0.85em;
    line-height: 1.35;
    color: var(--cd-grey--800);
  }
  .pipeline li:not(:last-child)::after {
    content: "›";
    position: absolute;
    top: 50%;
    right: -1.5rem;
    width: 1.5rem;
    transform: translateY(-50%);
    text-align: center;
    font-size: 1.6em;
    color: var(--brand-primary--text);
  }
  .glue {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    column-gap: 3rem;
    margin: 0.5rem 0 1.5rem;
  }
  .glue > div {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.3rem 1rem 1rem;
    font-size: 0.8em;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius);
    box-shadow: inset 0 6px 0 var(--brand-primary--text);
    background: var(--cd-white);
  }
  .glue span {
    color: var(--cd-grey--800);
  }
  .glue .core {
    justify-content: center;
    text-align: center;
    color: white;
    background: var(--brand-primary--text);
    border-color: var(--brand-primary--text);
    box-shadow: none;
  }
  .glue .core strong {
    font-family: var(--brand-font-heading);
    font-size: 1.4em;
  }
  .glue .core span {
    color: white;
  }
  .glue .core::before,
  .glue .core::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 3rem;
    border-top: 2px solid var(--brand-primary--text);
  }
  .glue .core::before {
    right: 100%;
  }
  .glue .core::after {
    left: 100%;
  }

  .explorer figure {
    margin: 0;
  }
  .boundary-map {
    height: 640px;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius--sm);
    overflow: hidden;
  }
  .explorer figcaption {
    margin-top: 0.5rem;
    font-weight: 700;
  }

  :global(body.present) {
    overflow: hidden;
  }
  :global(body.present .site-bar) {
    display: none;
  }
  :global(body.present) .deck {
    max-width: none;
    padding: 0;
  }
  :global(body.present) .slide {
    display: none;
  }
  :global(body.present) .slide.current {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6vh 8vw;
    border: none;
    border-radius: 0;
    box-shadow: none;
    font-size: clamp(1rem, 2.2vw, 2rem);
  }
  :global(body.present) .slide :global(p:not(:has(> img))) {
    display: none;
  }
  :global(body.present) .slide :global(p > img) {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }
  :global(body.present) .slide.current:not(.wide):has(:global(p > img)):has(:global(ul)) {
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-content: center;
    align-items: center;
    column-gap: 4vw;
  }
  :global(body.present) .slide.current:has(.glue) {
    display: grid;
    grid-template-columns: 2fr 3fr;
    align-content: center;
    align-items: center;
    column-gap: 4vw;
  }
  :global(body.present) .glue {
    grid-template-columns: 1fr;
    row-gap: 2.5rem;
    margin: 0;
  }
  :global(body.present) .glue .core::before,
  :global(body.present) .glue .core::after {
    left: 50%;
    right: auto;
    top: auto;
    width: 0;
    height: 2.5rem;
    border-top: none;
    border-left: 2px solid var(--brand-primary--text);
  }
  :global(body.present) .glue .core::before {
    bottom: 100%;
  }
  :global(body.present) .glue .core::after {
    top: 100%;
  }
  :global(body.present) .slide:has(:global(p > img)) :global(h2),
  :global(body.present) .slide:has(.glue) :global(h2) {
    grid-column: 1 / -1;
  }
  :global(body.present) .slide:has(:global(p > img)) :global(ul),
  :global(body.present) .slide:has(.glue) :global(ul) {
    font-size: 0.9em;
  }
  :global(body.present) .slide.wide :global(ul) {
    margin-top: 2vh;
  }
  :global(body.present) .slide.wide :global(p > img) {
    max-height: 46vh;
  }
  :global(body.present) .slide :global(p:has(> img)) {
    margin: 0;
    max-width: none;
  }
  :global(body.present) .logos {
    position: absolute;
    left: 8vw;
    bottom: 6vh;
    margin: 0;
  }
  :global(body.present) .logos img {
    height: 2.4em;
  }
  :global(body.present) .demo.current {
    justify-content: flex-start;
    padding: 2vh 2vw;
  }
  :global(body.present) .slide.demo :global(h2) {
    font-size: 1em;
    margin-bottom: 0.5rem;
  }
  :global(body.present) .slide.demo :global(h2)::after {
    display: none;
  }
  :global(body.present) .demo iframe {
    flex: 1;
    height: auto;
  }
  :global(body.present) .explorer figure {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  :global(body.present) .boundary-map {
    flex: 1;
    height: auto;
  }
  :global(body.present) .slide :global(h1) {
    font-size: 2.4em;
  }
  :global(body.present) .slide :global(h2) {
    font-size: 1.8em;
  }
  :global(body.present) .slide :global(h3) {
    font-size: 1.1em;
  }
  :global(body.present) .slide :global(ul) {
    font-size: 1.1em;
  }
  :global(body.present) .slide :global(table) {
    font-size: 0.97em;
  }
  :global(body.present) .slide :global(td) {
    padding-block: 0.3em;
  }
</style>
